<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SmsPing</AssemblyName>
    <RootNamespace>SmsPing</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <!-- Cung cấp reference assemblies net48 để build được trên mọi máy chủ (không phụ thuộc targeting pack cài sẵn).
       SerialPort nằm trong System.dll (đã tham chiếu ngầm), nên KHÔNG cần System.IO.Ports. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
